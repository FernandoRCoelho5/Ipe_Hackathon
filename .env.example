# ─────────────────────────────────────────────────────────────
# Ipê · Inteligência Térmica Urbana — variáveis de ambiente
# Copie para .env.local e ajuste. Nada aqui é obrigatório para a demo.
# ─────────────────────────────────────────────────────────────

# URL pública (metadados, Open Graph e links absolutos em relatórios)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fonte de dados dos repositórios: "mock" (dados demonstrativos) | "postgis" (roadmap)
DATA_SOURCE=mock

# Segredo para assinar o cookie de sessão de demonstração (HMAC-SHA256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-um-segredo-com-32-bytes-ou-mais

# PostgreSQL 16 + PostGIS 3.4 (docker-compose.yml). Usado quando DATA_SOURCE=postgis.
DATABASE_URL=postgres://ipe:ipe@localhost:5432/ipe

# Analytics (desligado por padrão)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
